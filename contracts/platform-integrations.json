{
  "schemaVersion": 1,
  "application": "goreecloud-app-store",
  "productionAcceptance": false,
  "nativeApplication": true,
  "integrations": {
    "glazeUi": {
      "target": "1.6.0",
      "conformanceAccepted": false
    },
    "goreecloudIdentity": {
      "sourceBoundaryImplemented": true,
      "productionConnected": false,
      "authority": [
        "identity",
        "authentication",
        "authorization",
        "accounts",
        "devices",
        "credentials",
        "sessions",
        "delegated-authority"
      ]
    },
    "wardveilSecurity": {
      "sourceBoundaryImplemented": true,
      "productionConnected": false,
      "authority": [
        "package-trust",
        "verification",
        "protection",
        "security-response"
      ]
    },
    "privacyShield": {
      "sourceBoundaryImplemented": true,
      "productionConnected": false,
      "developmentAnalytics": false
    },
    "everkeep": {
      "sourceBoundaryImplemented": true,
      "productionConnected": false,
      "authority": [
        "library-recovery",
        "history-preservation",
        "continuity-evidence"
      ]
    },
    "goreecloudMesh": {
      "sourceBoundaryImplemented": true,
      "productionConnected": false,
      "authority": [
        "catalog-coordination",
        "capability-discovery",
        "lifecycle-events"
      ]
    }
  }
}
